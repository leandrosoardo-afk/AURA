# No hace falta copiarlo a mano: "npm run db:crear" genera .env con una clave aleatoria.
# Usuario administrador de PostgreSQL. Solo lo usan los scripts de base, nunca la app.
DATABASE_ADMIN_URL=postgres://TU_USUARIO@localhost:5432/postgres
# Rol de la app: sin privilegios de administrador, sujeto a las políticas de RLS.
DATABASE_URL=postgres://cajaclara_v4_app:CLAVE@localhost:5432/cajaclara_v4
# Clave de Gemini para el chatbot (aistudio.google.com/apikey). Sin clave responde la guía local.
GEMINI_API_KEY=
# Opcional. Por defecto: gemini-3.5-flash-lite
GEMINI_MODEL=
# Modelo que se usa si el principal está saturado (por defecto gemini-3.1-flash-lite).
GEMINI_MODEL_RESPALDO=
# Correo para recuperar contraseñas. Sin esto, en desarrollo el enlace aparece en la terminal del servidor.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una contraseña de aplicación en SMTP_PASS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Dirección de la app que va en los enlaces de los mails.
APP_URL=http://localhost:4173
DATABASE_TEST_URL=postgres://cajaclara_v4_app:CLAVE@localhost:5432/cajaclara_v4_test
