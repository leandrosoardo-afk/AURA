{
  "name": "caja-clara-v4",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"srv,web\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --include .env server/index.ts",
    "db:crear": "tsx server/scripts/dbCrear.ts",
    "db:migrar": "tsx server/scripts/dbMigrar.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx server/scripts/dbMigrar.ts --test && vitest run",
    "enlace": "docker compose logs tunel 2>&1 | grep -oE 'https://[a-z0-9-]+\\.trycloudflare\\.com' | tail -1",
    "correo:probar": "tsx server/scripts/probarCorreo.ts",
    "seguridad": "npm audit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "gsap": "^3.15.1",
    "helmet": "^8.3.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.68.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.14",
    "three": "^0.169.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
